DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/testdb
ADMIN_USERNAME_HASH=replace_with_sha256_base64url_username_hash
ADMIN_PASSWORD_HASH=pbkdf2_sha256:600000:replace_with_salt:replace_with_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=replace_with_vapid_private_key
